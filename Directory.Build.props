<Project>
  <PropertyGroup>
    <!-- .NET 8 (LTS): builds with Visual Studio 2022 (17.8 or later) and the .NET 8 SDK.
         .NET 8 support ends on November 10, 2026; to move to .NET 10 change this to net10.0
         (needs Visual Studio 2026 or the .NET 10 SDK, and the .NET 10 Hosting Bundle on the server). -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
