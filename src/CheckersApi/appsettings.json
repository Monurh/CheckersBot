{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Engine": {
    "Type": "kingsrow",
    "Name": "kingsrow",
    "Path": "C:\\Program Files (x86)\\CheckerBoard\\engines\\Kingsrow64.dll",
    "WorkerPath": "worker/KrWorker.exe",
    "Workers": 2,
    "Databases": "C:\\kr_english_wld",
    "DbMaxPieces": 8,
    "DbCacheMb": 2048,
    "HashMb": 128,
    "SearchThreads": 2,
    "Book": 3,
    "ScorePerspective": "black",
    "StartupTimeoutMs": 120000
  },

  "Cache": { "Capacity": 20000, "TtlMinutes": 15 },

  "Limits": {
    "DefaultSoftTimeMs": 300,
    "DefaultHardTimeMs": 1200,
    "MaxSoftTimeMs": 10000,
    "MaxHardTimeMs": 30000
  },

  "Levels": {
    "weak":   { "SoftTimeMs": 100, "MaxDepth": 8,  "UseTablebase": true },
    "medium": { "SoftTimeMs": 250, "MaxDepth": 12, "UseTablebase": true },
    "strong": { "SoftTimeMs": 450, "MaxDepth": 18, "UseTablebase": true }
  },

  "Tablebase": { "Enabled": true, "TimeMs": 20 },

  "RequestLog": { "Path": "logs/requests-{date}.jsonl" },

  "Cors": { "AllowedOrigins": [] }
}
